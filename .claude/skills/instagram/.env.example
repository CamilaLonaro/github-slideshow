# Copie para .env (mesma pasta) e preencha. O .env é ignorado pelo git.
IG_ACCESS_TOKEN=
# Opcional: ID da conta profissional do Instagram. Descoberto automaticamente se vazio.
IG_USER_ID=
# Necessários apenas para token-exchange / token-debug.
IG_APP_ID=
IG_APP_SECRET=
# graph.facebook.com (padrão, login via Facebook) ou graph.instagram.com (login via Instagram)
IG_GRAPH_HOST=graph.facebook.com
IG_API_VERSION=v23.0
